{
  "name": "opencode-go",
  "description": "OpenCode Go 档：build/explore/general/browse=deepseek-v4.1-flash（傻快主力）；plan/expert=glm-5.3（前沿档）",
  "model": {
    "build": "opencode-go/deepseek-v4.1-flash",
    "plan": "opencode-go/glm-5.3",
    "explore": "opencode-go/deepseek-v4.1-flash",
    "general": "opencode-go/deepseek-v4.1-flash",
    "expert": "opencode-go/glm-5.3",
    "browse": "opencode-go/deepseek-v4.1-flash"
  },
  "promptVariants": {},
  "permissions": {
    "build": [
      { "action": "subagent", "resource": "*", "effect": "deny" },
      { "action": "subagent", "resource": "plan", "effect": "allow" },
      { "action": "subagent", "resource": "explore", "effect": "allow" },
      { "action": "subagent", "resource": "general", "effect": "allow" },
      { "action": "subagent", "resource": "expert", "effect": "allow" },
      { "action": "subagent", "resource": "browse", "effect": "allow" }
    ]
  },
  "features": {
    "contractInjector": { "enabled": true },
    "continuation": {
      "enabled": true, "countdownSeconds": 2, "cooldownBaseMs": 5000,
      "backoffPowCap": 5, "maxConsecutiveFailures": 5, "failureResetWindowMs": 600000,
      "maxStagnation": 2, "abortWindowMs": 3000, "contextSkipPct": 85,
      "maxTotalInjections": 200, "toolLoopWarn": 3, "toolLoopStop": 5
    },
    "profileEngine": { "enabled": true }
  }
}
